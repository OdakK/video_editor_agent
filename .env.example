# Model for the editing agent, as provider:model (any provider supported by LangChain's init_chat_model)
VIDEO_AGENT_MODEL=openai:gpt-4.1-mini
OPENAI_API_KEY=
# VIDEO_AGENT_MODEL=anthropic:claude-sonnet-5-5   (uv sync --extra anthropic)
# ANTHROPIC_API_KEY=
# VIDEO_AGENT_MODEL=azure_openai:<deployment>     (also set AZURE_OPENAI_API_KEY, AZURE_OPENAI_ENDPOINT, OPENAI_API_VERSION)

# Where the analysis output and the edit live
MEDIA_BUNDLE_PATH=output/analysis_bundle.json
MEDIA_STORE_PATH=output/media_store.db
TIMELINE_PATH=output/timeline.otio

# Optional: LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
